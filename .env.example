# ═══════════════════════════════════════════════════════════════════════════
# SecAgent Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Primary LLM selection (the installer can set these interactively) ──
# SECAGENT_LLM_PROVIDER=openai
# SECAGENT_LLM_MODEL=gpt-4o-mini
# Legacy comma-separated keys are supported; named provider keys are more reliable.
LLM_API_KEYS=

# Or set individual provider keys:
# OPENAI_API_KEY=replace-with-your-key
# ANTHROPIC_API_KEY=replace-with-your-key
# GROQ_API_KEY=replace-with-your-key
# DEEPSEEK_API_KEY=replace-with-your-key
# GEMINI_API_KEY=replace-with-your-key
# OPENROUTER_API_KEY=replace-with-your-key
# XAI_API_KEY=replace-with-your-key

# For SECAGENT_LLM_PROVIDER=custom, set the exact chat-completions route:
# SECAGENT_LLM_NAME=my-gateway
# SECAGENT_LLM_MODEL=my-model
# SECAGENT_LLM_API_KEY=your-key
# SECAGENT_LLM_ENDPOINT=https://gateway.example/v1/chat/completions
# Legacy OpenAI base URL override (optional):
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local LLM (offline mode)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── External Intelligence ───────────────────────────────────────────────────
SHODAN_API_KEY=
CHAOS_API_KEY=

# ── Database & Queue ──────────────────────────────────────────────────────
DB_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://secagents:changeme@localhost:5432/secagents
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=secagents_redis

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET=generate_a_long_random_string_here

# ── CORS (comma-separated origins allowed by the API) ─────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Scope Control (REQUIRED — enforced on every scan) ─────────────────────
ALLOWED_DOMAINS=example.com,*.example.com
BLOCKED_DOMAINS=

# ── Performance ───────────────────────────────────────────────────────────
MAX_SCAN_DEPTH=3
MAX_CONCURRENT_AGENTS=4

# ── Integrations (Optional) ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
JIRA_URL=
JIRA_API_TOKEN=
JIRA_PROJECT=SEC
GITHUB_TOKEN=

# ── OAST / Out-of-band ────────────────────────────────────────────────────
INTERACTSH_SERVER=

# ── SecAgent Platform ─────────────────────────────────────────────────────
SECAGENT_GITHUB_REPO=gl1tch0x1/cog-ai
RESULTS_DIR=./cog-ai-results
